import matplotlib.pyplot as plt
import numpy as np
import pandas as pd


def plot_quiver_vis(df, selected_month, selected_year=2019):
  plt.close()
  # ကိုရီးယားစာ ဖောင့်ပြဿနာ ရှင်းလင်းရန်
  plt.rcParams["font.family"] = "Malgun Gothic"

  # ရွေးချယ်ထားသော နှစ်နှင့် လအလိုက် ဒေတာများကို စစ်ထုတ်ခြင်း
  df = df[(df["Year"] == selected_year) & (df["Month"] == selected_month)]

  # လေတိုက်နှုန်း (Wind Speed) အတွက် ပျမ်းမျှတွက်ချက်ခြင်း
  c = df.pivot_table("WSPD", "Day", "Hour", aggfunc="mean")

  # လေတိုက်ရာ দিক (Wind Direction) အတွက် u, v တွက်ချက်ခြင်း
  u = np.cos(np.deg2rad(df.pivot_table("WD", "Day", "Hour", aggfunc="mean")))
  v = np.sin(np.deg2rad(df.pivot_table("WD", "Day", "Hour", aggfunc="mean")))

  # x ဝင်ရိုး (နာရီ - 0 မှ 23 ထိ)
  x = np.arange(0, 24, 1).tolist()

  # လအလိုက် ရက်အရေအတွက်ပေါ်မူတည်၍ y ဝင်ရိုး (ရက်စွဲ) သတ်မှတ်ခြင်း
  if selected_month in [1, 3, 5, 7, 8, 10, 12]:
    y = np.arange(1, 32, 1)[::-1].tolist()
  elif selected_month in [4, 6, 9, 11]:
    y = np.arange(1, 31, 1)[::-1].tolist()
  elif selected_month == 2:
    y = np.arange(1, 29, 1)[::-1].tolist()

  # Quiver Plot ဖန်တီးခြင်း
  plt.quiver(
      x,
      y,
      u,
      v,
      c,
      units="height",
      pivot="mid",
      scale=30,
      color="blue",
      cmap=plt.cm.inferno_r,
  )
  plt.colorbar()
  plt.clim(0, 30)
  plt.title(
      "{}년 {}월 풍향(degree), 풍속(kt) quiver plot".format(
          selected_year, selected_month
      )
  )
  plt.xlabel("Hour of a day")
  plt.ylabel("Day of a month")
  plt.xticks(x, fontsize=8, rotation=60)
  plt.yticks(y, fontsize=8)
  plt.gcf().set_size_inches(20, 10)
  plt.grid()
  plt.show()
  return plt
# ၁။ သင့်ရဲ့ CSV ဒေတာဖိုင်ကို ဖတ်ရှုခြင်း (ဖိုင်နာမည်ကို အမှန်အတိုင်း ပြင်ရေးပါ)
df = pd.read_csv("your_data_file.csv")

# ၂။ ၂၀၁၉ ခုနှစ်၊ ဇန်နဝါရီလ (Month 1) အတွက် ဇယားထုတ်ရန် Function ကို ခေါ်သုံးခြင်း
plot_quiver_vis(df, selected_month=1, selected_year=2019)
